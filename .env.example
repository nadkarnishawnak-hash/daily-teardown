# ---- Required -------------------------------------------------------------
# Brain: Claude with server-side web search. (The only paid piece of the stack.)
ANTHROPIC_API_KEY=sk-ant-...

# Gmail account that SENDS the brief and RECEIVES your replies (capture loop).
# Needs 2-Step Verification on, then an App Password: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=nadkarnishawnak@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where the brief goes (defaults to GMAIL_ADDRESS if unset)
RECIPIENT_EMAIL=nadkarnishawnak@gmail.com

# ---- Publishing (set automatically inside GitHub Actions) ----------------
# GITHUB_REPOSITORY=yourname/daily-teardown
# GITHUB_TOKEN=ghp_...            # only needed for a LOCAL --publish test
# SITE_URL=https://yourname.github.io/daily-teardown/   # override only if using a custom domain

# ---- Optional knobs -------------------------------------------------------
# CLAUDE_MODEL=claude-opus-5      # or claude-sonnet-5 (~half the cost, slightly less thorough)
# CLAUDE_EFFORT=high              # low | medium | high | xhigh
# MAX_SEARCHES=12                 # web searches per teardown ($10 per 1,000)

# TTS_PROVIDER=auto               # auto | edge | google | openai | elevenlabs
# TTS_VOICE=                      # provider-specific voice name/id (see README)
# GOOGLE_TTS_API_KEY=             # optional: Google Cloud TTS (needs a card on the GCP account)
# OPENAI_API_KEY=                 # optional: gpt-4o-mini-tts (~$2/mo)
# ELEVENLABS_API_KEY=             # optional: most human voice (~$5-22/mo)

# PODCAST_TITLE=The Daily Teardown
# PODCAST_AUTHOR=Shawnak Nadkarni
